# Base URL of the FastAPI backend. No trailing slash.
# Used by `npm run build` (Vite's default mode is "production"). Netlify also
# sets VITE_API_BASE_URL directly in its own env var UI, which takes precedence
# at build time -- this file just keeps a local `npm run build` correct too.
VITE_API_BASE_URL=https://mbere-ml.onrender.com
