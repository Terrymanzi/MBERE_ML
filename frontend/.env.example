# Reference only -- the repo already ships working frontend/.env.development
# and frontend/.env.production (Vite loads the one matching its mode
# automatically). Use this file if you need a from-scratch template.
#
# Base URL of the FastAPI backend. No trailing slash.
# The dev server runs on http://localhost:3000 (allowed by the backend CORS list).
VITE_API_BASE_URL=http://localhost:8000
